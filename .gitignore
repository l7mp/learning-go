*.DS_Store

# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, build with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

.vscode/*
env/.vagrant/*

# The lab Dockerfiles build from a vendor directory, so working through the labs leaves one
# behind in every lab module. It is derived from go.mod and go.sum and never belongs in git.
99-labs/code/*/vendor/
